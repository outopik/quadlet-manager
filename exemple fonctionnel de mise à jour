#!/bin/bash
# /usr/local/bin/podman-update-all.sh

# Codes de couleur ANSI
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

USERS=(plex jellyfin jellyfinbeta navidrome duckdns traefik adguard immich owncloud ha)

clear
echo -e "${BLUE}=== Mise à jour des conteneurs rootless Podman (avec le paramètre AutoUpdate=registry) ===${NC}"
echo ""

for user in "${USERS[@]}"; do
    uid=$(id -u "$user" 2>/dev/null)

    if [[ -z "$uid" ]]; then
        echo -e "${RED}✗${NC} Utilisateur ${CYAN}$user${NC} introuvable, skip."
        echo ""
        continue
    fi

    if [ -d "/run/user/$uid" ]; then
        echo -e "${CYAN}=== Mise à jour des conteneurs de $user (UID: $uid) ===${NC}"

        output=$(machinectl shell "${user}@" /usr/bin/podman auto-update 2>&1)
        exit_code=$?

        if [[ $exit_code -eq 0 ]]; then
            if [[ -n "$output" ]]; then
                # Colorer chaque ligne de sortie de podman auto-update
                while IFS= read -r line; do
                    if [[ "$line" =~ ^UNIT|^NAME ]]; then
                        echo -e "  ${BLUE}$line${NC}"
                    elif echo "$line" | grep -qi "error\|fail"; then
                        echo -e "  ${RED}$line${NC}"
                    elif echo "$line" | grep -qi "updated\|true"; then
                        echo -e "  ${GREEN}$line${NC}"
                    else
                        echo -e "  $line"
                    fi
                done <<< "$output"
            else
                echo -e "  ${YELLOW}Aucun conteneur à mettre à jour.${NC}"
            fi
            echo -e "  ${GREEN}✓ Terminé pour $user${NC}"
        else
            echo -e "  ${RED}✗ Erreur lors de la mise à jour pour $user${NC}"
            echo -e "  ${RED}$output${NC}"
        fi
    else
        echo -e "${YELLOW}⚠️  Session non active pour $user, skip.${NC}"
    fi
    echo ""
done

for user in "${USERS[@]}"; do
    uid=$(id -u "$user" 2>/dev/null)

    if [[ -z "$uid" ]]; then
        continue
    fi

    echo -e "${CYAN}Nettoyage Podman pour $user${NC}"

    output=$(machinectl shell "${user}@" /usr/bin/podman image prune -af 2>&1)
    exit_code=$?

    if [[ $exit_code -eq 0 ]]; then
        if [[ -n "$output" ]]; then
            echo "$output"
        else
            echo -e "  ${YELLOW}Aucune image inutilisée.${NC}"
        fi
        echo -e "  ${GREEN}✓ Nettoyage terminé pour $user${NC}"
    else
        echo -e "  ${RED}✗ Erreur nettoyage pour $user${NC}"
        echo "$output"
    fi
done

echo -e "${BLUE}=== Mise à jour terminée ===${NC}"
